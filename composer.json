{
    "name": "phasync/plug",
    "description": "Translate whole PHP applications with phasync/babel so their blocking calls go to phasync/hooked's cooperative replacements: what ext-phasync does (sapi(), non-blocking I/O), done in userspace",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "phasync/babel": "^0.2",
        "phasync/hooked": "^0.1"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phasync/phasync": "^2.0.4",
        "phasync/serializor": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "phasync\\plug\\": "src/"
        },
        "files": [
            "src/path.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "phasync\\plug\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    }
}
